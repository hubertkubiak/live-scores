# Copy to server/.env (git-ignored). Without SPORTS_API_KEY the server runs on mock data.
SPORTS_API_KEY=
# {sport} is replaced with the provider slug, e.g. football, american-football.
SPORTS_API_BASE=https://v1.{sport}.sportsapipro.com
# sportsapipro | mock
DATA_PROVIDER=mock
PORT=8787
# How often the REST snapshot of today's matches is refreshed (9 requests per refresh).
SNAPSHOT_REFRESH_MINUTES=10
